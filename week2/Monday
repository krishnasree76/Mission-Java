import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int sum=addnumbers(50,20);
        System.out.println("Sum:"+sum);
        long square=squareofanumber(12,12);
        System.out.println("Square:"+square);
        int n=s.nextInt();
        evenOdd(n);
        System.out.println(factorial(n));
        System.out.println(reverse(n));
        palindrome(n);
        int a=10;
        int b=20;
        int c=30;
        large(a,b,c);
        System.out.println(prime(n));
    }
    //Method to add two numbers.
        public static int addnumbers(int a,int b){
            int sum=a+b;
            return sum;
        }
    //Method to find the square of a number.
    public static long squareofanumber(int a,int b){
        long square=a*b;
        return square;
    }
    //Method to check even or odd.
    public static void evenOdd(int n){
        if(n%2==0){
            System.out.println("even");
        }else{
            System.out.println("odd");
        }
    }
    //Method to calculate factorial.
    public static long factorial(int n){
        if(n<0){
            throw new IllegalArgumentException("Number must be non negative");
        }
        long result=1;
        for(int i=2;i<=n;i++){
            result*=i;
        }
        return result;
        
    }
    //Method to reverse a number.
    public static int reverse(int n){
        int rev=0;
        while(n!=0){
            int digit=n%10;
            rev=rev*10+digit;
            n/=10;
            
        }
    return rev;
    }
    //Method to check palindrome.
    public static void palindrome(int n){
        if(n==reverse(n)){
            System.out.println("Palindrome");
        }else{
            System.out.println("Not Palindrome");
        }
    }
    //Method to find the largest of three numbers.
    public static void large(int a,int b,int c){
        if(a>=b && a>=c){
            System.out.println("a is greater");
        }else if(b>=a && b>=c){
            System.out.println("b is greater");
        }else{
            System.out.println("c is greater");
        }
    }
    //Method to check prime number.
    public static String prime(int n){
        if(n<=1){
            return "Not Prime";
        }
        for(int i=2;i*i<=n;i++){
            if(n%i==0){
                return "Not Prime";
            }
        }
    return "Prime";
    }

    
    
    
    
}
