
import java.util.*;
class Main {
    public static void main(String[] args) {
        //PRIMITIVE DATATYPES
        byte a=12;
        short b=123;
        int c=123456789;
        long d= 1234567890;
        float e=12.8f;
        double f=1233.33333333333333333333333333333333333;
        char g='A';
        boolean h=true;
        System.out.println(a+"\n"+b+"\n"+ c +"\n"+ d +"\n"+ e +"\n"+ f +"\n"+g +"\n" +h);
        //ABOUT
        String name = "Krishna Sree";
        byte age = 21;
        float cgpa = 9.1f;
        String collegename = "Shri Vishnu Engineering College For Women";
        System.out.println(name+"\n"+age+"\n"+cgpa+"\n"+collegename);
        //SUM OF TWO NUMBERS
        int u=4609;
        int k=1234;
