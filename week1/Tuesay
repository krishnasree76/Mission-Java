        double percentage=(avg/100)*100;
    System.out.println(name+"\n"+"Maths:"+maths+"\n"+"English:"+english+"\n"+"Physics:"+physics+"\n"+"Biology:"+biology+"\n"+"Telugu:"+telugu+"\n"+"Total:"+total+"\n"+"Average:"+avg+"\n"+"Percentage:"+percentage);
    }
